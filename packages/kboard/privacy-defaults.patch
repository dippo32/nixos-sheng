+QString UserStore::openFromDisk(const QString &language)
+{
+    close();
+    const QString path = pathFor(language);
+    QFile file(path);
+    QByteArray data;
+    if (file.exists()) {
+        if (!file.open(QIODevice::ReadOnly)) {
+            return QStringLiteral("Cannot read learned words %1: %2").arg(path, file.errorString());
+        }
+        data = file.readAll();
+    }
+    return open(language, data);
+}
