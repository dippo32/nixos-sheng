+void PredictionTest::disabledLearningDoesNotReadOrOverwriteHistory()
+{
+    m_engine->learn(QStringLiteral("PrivacyFixtureWord"));
+    m_engine->flush();
+    const QString path = UserStore::pathFor(m_engine->language());
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::ReadOnly));
+    const QByteArray original = file.readAll();
+    file.close();
+    QVERIFY(!original.isEmpty());
+
+    KBoardSettings::self()->setLearnWords(false);
+    QVERIFY(!m_engine->isLearned(QStringLiteral("PrivacyFixtureWord")));
+    m_engine->learn(QStringLiteral("DisabledWord"));
+    m_engine->forget(QStringLiteral("PrivacyFixtureWord"));
+    m_engine->clearLearned();
+    m_engine->flush();
+    auto second = TypingTest::readyEngine();
+    QVERIFY(second->isReady());
+    QVERIFY(!second->isLearned(QStringLiteral("PrivacyFixtureWord")));
+    QVERIFY(file.open(QIODevice::ReadOnly));
+    QCOMPARE(file.readAll(), original);
+    file.close();
+
+    KBoardSettings::self()->setLearnWords(true);
+    QVERIFY(m_engine->isLearned(QStringLiteral("PrivacyFixtureWord")));
+    QVERIFY(second->isLearned(QStringLiteral("PrivacyFixtureWord")));
