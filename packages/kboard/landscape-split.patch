+.pragma library
+
+// Keep Auto tied to landscape geometry, even on wide portrait displays.
+function shouldSplit(mode, width, screenHeight, baseHeight, stripHeight, rowCount) {
+    if (mode === 1)
+        return true;
+    if (mode === 2)
+        return false;
+    if (width <= screenHeight)
+        return false;
+    const keyWidth = width / 10;
+    const keyHeight = (baseHeight - stripHeight) / Math.max(1, rowCount);
+    return width >= 2400 || (width / Math.max(1, screenHeight) >= 1.4 && keyWidth > keyHeight * 1.5);
+}
